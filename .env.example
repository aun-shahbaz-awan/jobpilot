# Database. Local file by default; for Netlify use a free Turso database:
#   DATABASE_URL=libsql://your-db.turso.io
#   DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/jobpilot.db
DATABASE_AUTH_TOKEN=

# AI keys (all optional; the app works without any AI using its free matcher and templates).
# Keys can also be pasted in Settings. Env vars take priority.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_URL=http://localhost:11434

# Optional free key for higher Himalayas rate limits: https://himalayas.app/api-keys
HIMALAYAS_API_KEY=

# Email applications (optional). For Gmail use an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Protects /api/sync when deployed (Netlify scheduled function sends it).
CRON_SECRET=change-me

# Password to lock the app when deployed publicly. Leave empty for local use.
APP_PASSWORD=
